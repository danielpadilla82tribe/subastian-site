"use client";

import React, { useState, useEffect } from "react";
import Link from "next/link";

export default function StackAuditPage() {
  // Calculator inputs
  const [subscriptionCount, setSubscriptionCount] = useState<number>(14);
  const [monthlySpend, setMonthlySpend] = useState<number>(650);
  const [teamSize, setTeamSize] = useState<number>(3);
  const [primaryNiche, setPrimaryNiche] = useState<string>("Affiliate Marketing");

  // Lead capture state
  const [name, setName] = useState<string>("");
  const [email, setEmail] = useState<string>("");
  const [submitted, setSubmitted] = useState<boolean>(false);
  const [affiliateRef, setAffiliateRef] = useState<string>("");

  // Grab affiliate referral tag from URL if present
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const ref = params.get("via") || params.get("aff") || "";
    if (ref) setAffiliateRef(ref);
  }, []);

  // Waste benchmark estimates (grounded in Capterra / YouGov industry averages)
  const annualSpend = monthlySpend * 12;
  const estimatedUnusedSubs = Math.max(1, Math.round(subscriptionCount * 0.35));
  const estimatedAnnualWaste = Math.round(annualSpend * 0.32);
  const potentialMonthlySavings = Math.round(monthlySpend * 0.32);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!email) return;

    // TODO: Wire this payload to your existing "Subastian Waitlist" Google Sheet webhook
    const leadData = {
      name,
      email,
      roleDescription: primaryNiche,
      subscriptionCount,
      monthlySpend,
      estimatedWaste: estimatedAnnualWaste,
      affiliateRef,
      source: "calculator-audit",
    };

    console.log("Submitting Founding Roster lead:", leadData);

    // Fallback: If no backend API endpoint is wired yet, open mailto fallback
    // window.location.href = `mailto:daniel@subastian.us?subject=Founding Roster Signup&body=Name: ${encodeURIComponent(name)}%0AEmail: ${encodeURIComponent(email)}%0ANiche: ${encodeURIComponent(primaryNiche)}%0AEstimated Waste: \$${estimatedAnnualWaste}`;

    setSubmitted(true);
  };

  return (
    <main className="min-h-screen bg-slate-950 text-slate-100 selection:bg-blue-600 selection:text-white">
      {/* Header */}
      <nav className="border-b border-slate-800 bg-slate-900/50 backdrop-blur-md">
        <div className="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
          <Link href="/" className="text-xl font-bold tracking-tight text-white flex items-center gap-2">
            <span className="w-3 h-3 rounded-full bg-blue-500 animate-pulse" />
            Subastian
          </Link>
          <span className="text-xs uppercase tracking-wider font-semibold text-blue-400 bg-blue-950/80 px-3 py-1 rounded-full border border-blue-800">
            Audit Tool • Pre-Launch
          </span>
        </div>
      </nav>

      {/* Main Container */}
      <section className="max-w-5xl mx-auto px-6 py-12 md:py-16">
        <div className="text-center max-w-2xl mx-auto mb-12">
          <h1 className="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-4">
            How much is your software stack really costing you?
          </h1>
          <p className="text-slate-400 text-sm md:text-base leading-relaxed">
            Industry data shows up to 35% of software subscriptions sit unused or duplicate existing tools. Run the numbers below to see your stack audit snapshot.
          </p>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          {/* Left Column: Interactive Inputs */}
          <div className="lg:col-span-6 bg-slate-900/80 border border-slate-800 p-6 md:p-8 rounded-2xl shadow-xl space-y-6">
            <h2 className="text-lg font-semibold text-white border-b border-slate-800 pb-3">
              1. Your Software Profile
            </h2>

            {/* Input: Monthly Spend */}
            <div>
              <div className="flex justify-between items-center mb-2">
                <label className="text-sm font-medium text-slate-300">Total Monthly Spend (USD)</label>
                <span className="text-sm font-bold text-blue-400">{monthlySpend} USD/mo</span>
              </div>
              <input
                type="range"
                min={50}
                max={3000}
                step={25}
                value={monthlySpend}
                onChange={(e) => setMonthlySpend(Number(e.target.value))}
                className="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500"
              />
              <div className="flex justify-between text-xs text-slate-500 mt-1">
                <span>50 USD</span>
                <span>1,500 USD</span>
                <span>3,000 USD+</span>
              </div>
            </div>

            {/* Input: Number of Subscriptions */}
            <div>
              <div className="flex justify-between items-center mb-2">
                <label className="text-sm font-medium text-slate-300">Active Paid Subscriptions</label>
                <span className="text-sm font-bold text-blue-400">{subscriptionCount} tools</span>
              </div>
              <input
                type="range"
                min={3}
                max={40}
                step={1}
                value={subscriptionCount}
                onChange={(e) => setSubscriptionCount(Number(e.target.value))}
                className="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500"
              />
              <div className="flex justify-between text-xs text-slate-500 mt-1">
                <span>3</span>
                <span>20</span>
                <span>40+</span>
              </div>
            </div>

            {/* Input: Team Size */}
            <div>
              <div className="flex justify-between items-center mb-2">
                <label className="text-sm font-medium text-slate-300">Team / Seat Count</label>
                <span className="text-sm font-bold text-blue-400">{teamSize} {teamSize === 1 ? "person" : "people"}</span>
              </div>
              <input
                type="range"
                min={1}
                max={25}
                step={1}
                value={teamSize}
                onChange={(e) => setTeamSize(Number(e.target.value))}
                className="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500"
              />
            </div>

            {/* Input: Primary Niche */}
            <div>
              <label className="block text-sm font-medium text-slate-300 mb-2">What best describes your business?</label>
              <select
                value={primaryNiche}
                onChange={(e) => setPrimaryNiche(e.target.value)}
                className="w-full bg-slate-800 border border-slate-700 text-slate-100 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500"
              >
                <option value="Affiliate Marketing">Affiliate Marketing</option>
                <option value="Digital Agency / Freelancer">Digital Agency / Freelance Ops</option>
                <option value="Content Creator / Media">Content Creator / Media Production</option>
                <option value="E-commerce / DTC">E-commerce / DTC</option>
                <option value="SaaS / Indie Dev">SaaS / Indie Hacker</option>
              </select>
            </div>
          </div>

          {/* Right Column: Audit Results & Founding Roster Capture */}
          <div className="lg:col-span-6 space-y-6">
            {/* Snapshot Card */}
            <div className="bg-slate-900/90 border border-slate-800 p-6 md:p-8 rounded-2xl shadow-xl">
              <h2 className="text-lg font-semibold text-white mb-6 border-b border-slate-800 pb-3 flex items-center justify-between">
                <span>Your Stack Snapshot</span>
                <span className="text-xs font-normal text-slate-400">Industry benchmark estimate</span>
              </h2>

              <div className="grid grid-cols-2 gap-4 mb-6">
                <div className="p-4 rounded-xl bg-slate-800/60 border border-slate-700/60">
                  <div className="text-xs text-slate-400 uppercase font-medium">Annual Spend</div>
                  <div className="text-xl md:text-2xl font-bold text-white mt-1">
                    {annualSpend.toLocaleString()} USD
                  </div>
                </div>

                <div className="p-4 rounded-xl bg-red-950/30 border border-red-900/40">
                  <div className="text-xs text-red-400 uppercase font-medium">Estimated Annual Waste</div>
                  <div className="text-xl md:text-2xl font-bold text-red-400 mt-1">
                    ~{estimatedAnnualWaste.toLocaleString()} USD
                  </div>
                </div>
              </div>

              <div className="space-y-3 text-sm text-slate-300 pb-6 border-b border-slate-800">
                <div className="flex items-center justify-between">
                  <span className="text-slate-400">Likely duplicate or idle tools:</span>
                  <span className="font-semibold text-white">~{estimatedUnusedSubs} subscriptions</span>
                </div>
                <div className="flex items-center justify-between">
                  <span className="text-slate-400">Potential monthly savings:</span>
                  <span className="font-semibold text-emerald-400">~{potentialMonthlySavings} USD / month</span>
                </div>
              </div>

              {/* Roster Opt-In Form */}
              <div className="pt-6">
                {!submitted ? (
                  <form onSubmit={handleSubmit} className="space-y-4">
                    <div>
                      <h3 className="text-base font-semibold text-white">
                        Lock in founding pricing for Subastian
                      </h3>
                      <p className="text-xs text-slate-400 mt-1">
                        Subastian is currently in active development. Join the free founding roster to get early access when we launch and lock in founding rates. No credit card required.
                      </p>
                    </div>

                    <div className="space-y-2">
                      <input
                        type="text"
                        placeholder="Your First Name"
                        required
                        value={name}
                        onChange={(e) => setName(e.target.value)}
                        className="w-full bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500"
                      />
                      <input
                        type="email"
                        placeholder="Your Work Email"
                        required
                        value={email}
                        onChange={(e) => setEmail(e.target.value)}
                        className="w-full bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500"
                      />
                    </div>

                    <button
                      type="submit"
                      className="w-full bg-blue-600 hover:bg-blue-500 text-white font-medium py-2.5 rounded-lg text-sm transition-colors shadow-lg shadow-blue-600/20"
                    >
                      Join Free Founding Roster →
                    </button>

                    <p className="text-[11px] text-slate-500 text-center leading-relaxed">
                      We respect your privacy. Daniel personally reads every signup. Deletion requests honored anytime.
                    </p>
                  </form>
                ) : (
                  <div className="p-4 rounded-xl bg-blue-950/40 border border-blue-800 text-center space-y-2">
                    <div className="text-emerald-400 text-lg font-bold">You're on the Founding Roster!</div>
                    <p className="text-xs text-slate-300">
                      Thanks, {name || "there"}. Daniel will email you directly at <span className="text-white font-medium">{email}</span> as soon as early access opens. Your launch pricing is locked in.
                    </p>
                  </div>
                )}
              </div>
            </div>

            {/* Playbook Disclaimer Box */}
            <div className="p-4 rounded-xl bg-slate-900/50 border border-slate-800 text-xs text-slate-400 space-y-1">
              <span className="font-semibold text-slate-300">Methodology Note:</span> Unused subscription ratios and redundant tool estimates are derived from published Capterra and YouGov SaaS benchmarks. Individual results depend on your stack configuration.
            </div>
          </div>
        </div>
      </section>
    </main>
  );
}
